<?xml version="1.0" encoding="UTF-8"?>
<!-- Reelhouse's own player controls while a live channel plays (live_osd.py), laid out as Kodi's are for a channel from
     its own TV add-ons (Estuary's DialogSeekBar, VideoOSD and top bar): the programme's start and end above the ends of
     its progress bar, how far into it and how long it is in the middle, the clock with when it ends, and the channel's
     logo at the top left. A dialog over the picture that takes the remote: control 100 holds the focus (drawing
     nothing) while the controls are hidden. What it says is set on its controls from Python (changes to a dialog's own
     properties aren't drawn once it's open); what shows goes by home window properties, so the bars slide as Kodi's. -->
<window type="dialog">
  <defaultcontrol always="true">100</defaultcontrol>
  <controls>
    <control type="button" id="100">
      <left>0</left><top>0</top><width>1</width><height>1</height>
      <texturefocus>reelhouse/ui/clear.png</texturefocus><texturenofocus>reelhouse/ui/clear.png</texturenofocus>
      <onup>noop</onup><ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright><oninfo>noop</oninfo>
    </control>

    <!-- The top bar: the logo, the programme and the channel, the clock and when the programme ends. -->
    <control type="group" id="210">
      <visible>String.IsEqual(Window(Home).Property(reelhouse.liveosd),1)</visible>
      <animation type="Visible" reversible="false">
        <effect type="fade" start="0" end="100" time="300"/>
        <effect type="slide" start="0,-200" end="0,0" time="300" tween="cubic" easing="out"/>
      </animation>
      <animation type="Hidden" reversible="false">
        <effect type="fade" start="100" end="0" time="300"/>
        <effect type="slide" start="0,0" end="0,-200" time="300" tween="cubic" easing="out"/>
      </animation>
      <!-- Dark enough to hide Kodi's own bar, which it shows while the picture is paused (its time and "Paused"
           showed through a lighter one), then fading out (the bottom shading upside down: it starts as dark). -->
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>80</height>
        <texture colordiffuse="FA000000">reelhouse/ui/white.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>80</top><width>1920</width><height>160</height>
        <texture colordiffuse="FA000000" flipy="true">reelhouse/ui/shade-bottom.png</texture>
      </control>
      <control type="image" id="201">
        <left>20</left><top>10</top><width>64</width><height>64</height>
        <aspectratio>keep</aspectratio>
      </control>
      <control type="label" id="202">
        <left>100</left><top>7</top><width>1180</width><height>50</height>
        <font>font45</font><textcolor>{{TEXT}}</textcolor>
      </control>
      <control type="label" id="203">
        <left>100</left><top>62</top><width>1180</width><height>40</height>
        <font>font13</font><textcolor>{{TEXT_DIM}}</textcolor><aligny>center</aligny>
      </control>
      <control type="label" id="206">
        <left>100</left><top>102</top><width>600</width><height>40</height>
        <font>font13</font><textcolor>{{DANGER}}</textcolor><aligny>center</aligny>
      </control>
      <control type="label" id="204">
        <left>1300</left><top>0</top><width>600</width><height>100</height>
        <font>font_clock</font><textcolor>{{TEXT}}</textcolor><align>right</align>
      </control>
      <control type="label" id="205">
        <left>1096</left><top>74</top><width>800</width><height>50</height>
        <font>font13</font><textcolor>{{TEXT}}</textcolor><align>right</align>
      </control>
    </control>

    <!-- The bottom bar: the programme's start and end, its progress, the time into it, and the buttons. -->
    <control type="group" id="220">
      <visible>String.IsEqual(Window(Home).Property(reelhouse.liveosd),1)</visible>
      <animation type="Visible" reversible="false">
        <effect type="fade" start="0" end="100" time="300"/>
        <effect type="slide" start="0,200" end="0,0" time="300" tween="cubic" easing="out"/>
      </animation>
      <animation type="Hidden" reversible="false">
        <effect type="fade" start="100" end="0" time="300"/>
        <effect type="slide" start="0,0" end="0,200" time="300" tween="cubic" easing="out"/>
      </animation>
      <control type="image">
        <left>0</left><top>740</top><width>1920</width><height>160</height>
        <texture colordiffuse="E6000000">reelhouse/ui/shade-bottom.png</texture>
      </control>
      <control type="image">
        <left>0</left><top>900</top><width>1920</width><height>180</height>
        <texture colordiffuse="E6000000">reelhouse/ui/white.png</texture>
      </control>
      <control type="label" id="211">
        <left>20</left><top>912</top><width>400</width><height>50</height>
        <font>font13</font><textcolor>{{TEXT}}</textcolor><aligny>center</aligny>
      </control>
      <control type="label" id="212">
        <left>1500</left><top>912</top><width>400</width><height>50</height>
        <font>font13</font><textcolor>{{TEXT}}</textcolor><align>right</align><aligny>center</aligny>
      </control>
      <control type="progress" id="213">
        <left>0</left><top>960</top><width>1920</width><height>16</height>
        <texturebg colordiffuse="FF3A3D41">reelhouse/ui/white.png</texturebg>
        <midtexture colordiffuse="{{ACCENT}}">reelhouse/ui/white.png</midtexture>
      </control>
      <control type="label" id="214">
        <left>480</left><top>985</top><width>960</width><height>60</height>
        <font>font45</font><textcolor>{{TEXT}}</textcolor><align>center</align>
      </control>
      <!-- Left: previous channel, pause (play while paused; not there when Kodi can't pause the stream, as for most live
           ones, and the rest close up, as Estuary's), stop, next channel, record (when the account may: white, red
           while the programme records); right: the channels, the programme's details, Kodi's subtitles and its
           settings. -->
      <!-- include live-osd-button id=301 x=20 ix=36 icon=skipPrev colour={{TEXT}} left=noop right=302 shown=true iconshown=true shift=0 -->
      <!-- include live-osd-button id=302 x=106 ix=122 icon=pause colour={{TEXT}} left=301 right=303 shown=Player.PauseEnabled iconshown="Player.PauseEnabled + !Player.Paused" shift=0 -->
      <control type="image">
        <left>122</left><top>1006</top><width>44</width><height>44</height>
        <texture colordiffuse="{{TEXT}}">reelhouse/icons/play.png</texture>
        <visible>Player.PauseEnabled + Player.Paused</visible>
      </control>
      <!-- include live-osd-button id=303 x=192 ix=208 icon=stop colour={{TEXT}} left=302 right=304 shown=true iconshown=true shift=-86 -->
      <!-- include live-osd-button id=304 x=278 ix=294 icon=skipNext colour={{TEXT}} left=303 right=305 shown=true iconshown=true shift=-86 -->
      <!-- include live-osd-button id=305 x=364 ix=380 icon=record colour={{TEXT}} left=304 right=311 shown="String.IsEqual(Window(Home).Property(reelhouse.liveosdrecord),1)" iconshown="String.IsEqual(Window(Home).Property(reelhouse.liveosdrecord),1) + !String.IsEqual(Window(Home).Property(reelhouse.liveosdrecording),1)" shift=-86 -->
      <control type="image">
        <left>380</left><top>1006</top><width>44</width><height>44</height>
        <texture colordiffuse="{{DANGER}}">reelhouse/icons/record.png</texture>
        <visible>String.IsEqual(Window(Home).Property(reelhouse.liveosdrecord),1) + String.IsEqual(Window(Home).Property(reelhouse.liveosdrecording),1)</visible>
        <animation effect="slide" end="-86,0" time="0" condition="!Player.PauseEnabled">Conditional</animation>
      </control>
      <!-- include live-osd-button id=311 x=1566 ix=1582 icon=list colour={{TEXT}} left=305 right=312 shown=true iconshown=true shift=0 -->
      <!-- include live-osd-button id=312 x=1652 ix=1668 icon=info colour={{TEXT}} left=311 right=313 shown=true iconshown=true shift=0 -->
      <!-- include live-osd-button id=313 x=1738 ix=1754 icon=subtitles colour={{TEXT}} left=312 right=314 shown=true iconshown=true shift=0 -->
      <!-- include live-osd-button id=314 x=1824 ix=1840 icon=settings colour={{TEXT}} left=313 right=noop shown=true iconshown=true shift=0 -->
    </control>
    <!-- The programme's details (Info), over the bottom bar's shading. -->
    <control type="group" id="230">
      <visible>String.IsEqual(Window(Home).Property(reelhouse.liveosd),1) + String.IsEqual(Window(Home).Property(reelhouse.liveosdinfo),1)</visible>
      <animation effect="fade" time="200">VisibleChange</animation>
      <control type="image">
        <left>0</left><top>600</top><width>1920</width><height>300</height>
        <texture colordiffuse="D0111315">reelhouse/ui/white.png</texture>
      </control>
      <control type="image" id="231">
        <left>40</left><top>630</top><width>200</width><height>200</height>
        <aspectratio>keep</aspectratio>
      </control>
      <control type="label" id="232">
        <left>280</left><top>618</top><width>1600</width><height>60</height>
        <font>font36_title</font><textcolor>{{TEXT}}</textcolor><aligny>center</aligny>
      </control>
      <control type="label" id="233">
        <left>280</left><top>676</top><width>1600</width><height>40</height>
        <font>font13</font><textcolor>{{TEXT_DIM}}</textcolor><aligny>center</aligny>
      </control>
      <control type="textbox" id="234">
        <left>280</left><top>724</top><width>1600</width><height>116</height>
        <font>font13</font><textcolor>{{TEXT}}</textcolor>
      </control>
      <control type="label" id="235">
        <left>280</left><top>846</top><width>1600</width><height>40</height>
        <font>font13</font><textcolor>{{TEXT_DIM}}</textcolor><aligny>center</aligny>
      </control>
    </control>

  </controls>
</window>
