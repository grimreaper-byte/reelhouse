<!-- An episode on a series' page (recording_series.py), as a library's episode: its picture (TMDB's still, else the
     guide's), else its channel's logo and name; REC, Scheduled or what went wrong in the bottom left; its name, and
     its day, time, length and size; on Everyone's, who set it. -->
<control type="image">
  <left>12</left><top>12</top><width>410</width><height>230</height>
  <texture border="16" colordiffuse="{{ELEV2}}">reelhouse/ui/box.png</texture>
</control>
<control type="image">
  <left>157</left><top>52</top><width>120</width><height>90</height>
  <aspectratio>keep</aspectratio>
  <texture background="true">$INFO[ListItem.Art(icon)]</texture>
  <visible>String.IsEmpty(ListItem.Art(thumb))</visible>
</control>
<control type="label">
  <left>32</left><top>150</top><width>370</width><height>40</height>
  <font>font12</font><textcolor>{{TEXT_FAINT}}</textcolor><align>center</align><aligny>center</aligny>
  <label>$INFO[ListItem.Label]</label>
  <visible>String.IsEmpty(ListItem.Art(thumb))</visible>
</control>
<control type="image">
  <left>12</left><top>12</top><width>410</width><height>230</height>
  <aspectratio>scale</aspectratio><fadetime>200</fadetime>
  <texture background="true" diffuse="reelhouse/ui/mask-landscape.png">$INFO[ListItem.Art(thumb)]</texture>
</control>
<control type="group">
  <left>22</left><top>202</top>
  <visible>String.IsEqual(ListItem.Property(state),recording) + !String.IsEqual(ListItem.Property(trouble),true)</visible>
  <control type="image"><width>78</width><height>32</height><texture border="15" colordiffuse="{{DANGER}}">reelhouse/ui/pill-small.png</texture></control>
  <control type="label">
    <width>78</width><height>32</height>
    <font>font10</font><textcolor>FFFFFFFF</textcolor><align>center</align><aligny>center</aligny>
    <label>● REC</label>
  </control>
</control>
<control type="group">
  <left>22</left><top>202</top>
  <visible>String.IsEqual(ListItem.Property(state),scheduled)</visible>
  <control type="image"><width>120</width><height>32</height><texture border="15" colordiffuse="{{WARN}}">reelhouse/ui/pill-small.png</texture></control>
  <control type="label">
    <width>120</width><height>32</height>
    <font>font10</font><textcolor>{{ACCENT_TEXT}}</textcolor><align>center</align><aligny>center</aligny>
    <label>Scheduled</label>
  </control>
</control>
<control type="group">
  <left>22</left><top>202</top>
  <visible>String.IsEqual(ListItem.Property(trouble),true)</visible>
  <control type="image"><width>260</width><height>32</height><texture border="15" colordiffuse="{{DANGER}}">reelhouse/ui/pill-small.png</texture></control>
  <control type="label">
    <left>12</left><width>236</width><height>32</height>
    <font>font10</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
    <label>$INFO[ListItem.Property(tag)]</label>
  </control>
</control>
<control type="label">
  <left>12</left><top>252</top><width>410</width><height>36</height>
  <font>font12</font><textcolor>{{TEXT}}</textcolor>
  <label>$INFO[ListItem.Label]</label>
</control>
<control type="label">
  <left>12</left><top>288</top><width>410</width><height>32</height>
  <font>font10</font><textcolor>{{TEXT_DIM}}</textcolor>
  <label>$INFO[ListItem.Label2]</label>
</control>
<!-- include recording-owner-line top=324 width=410 namewidth=372 -->
