  <label>$INFO[ListItem.Label]</label>
  <visible>!String.IsEmpty(ListItem.Label2)</visible>
</control>
<control type="label">
  <left>440</left><top>8</top><width>292</width><height>44</height>
  <font>font12</font><textcolor>{{tag}}</textcolor><align>right</align><aligny>center</aligny>
  <label>$INFO[ListItem.Property(tag)]</label>
</control>
<control type="label">
