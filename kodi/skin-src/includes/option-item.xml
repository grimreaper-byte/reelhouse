<!-- One choice: its name, a tag on the right (such as "Plays by default") and, when it has one, a line of detail. -->
<control type="label">
  <left>28</left><top>0</top><width>480</width><height>90</height>
  <font>font13</font><textcolor>{{text}}</textcolor><aligny>center</aligny>
  <label>$INFO[ListItem.Label]</label>
  <visible>String.IsEmpty(ListItem.Label2)</visible>
</control>
<control type="label">
  <left>28</left><top>8</top><width>480</width><height>44</height>
