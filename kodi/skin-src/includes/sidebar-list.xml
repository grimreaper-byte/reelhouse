  <!-- One of the sidebar's two lists ({{list}}); the names and counts show while either has the focus. -->
  <control type="list" id="{{list}}">
    <left>0</left><top>{{top}}</top><width>392</width><height>{{height}}</height>
    <onup>9000</onup><ondown>9002</ondown>
    <orientation>vertical</orientation>
    <scrolltime tween="cubic" easing="out">150</scrolltime>
    <itemlayout width="392" height="64">
      <control type="image">
        <left>36</left><top>12</top><width>40</width><height>40</height>
        <texture colordiffuse="{{TEXT_DIM}}">$INFO[ListItem.Property(icon)]</texture>
        <visible>!String.IsEqual(ListItem.Property(active),true)</visible>
      </control>
      <control type="image">
        <left>36</left><top>12</top><width>40</width><height>40</height>
        <texture colordiffuse="{{ACCENT}}">$INFO[ListItem.Property(icon)]</texture>
        <visible>String.IsEqual(ListItem.Property(active),true)</visible>
      </control>
      <control type="image">
        <left>36</left><top>12</top><width>40</width><height>40</height>
        <texture colordiffuse="{{DANGER}}">$INFO[ListItem.Property(spot)]</texture>
      </control>
      <control type="label">
        <left>104</left><top>0</top><width>210</width><height>64</height>
        <font>font13</font><textcolor>{{TEXT_DIM}}</textcolor><aligny>center</aligny>
        <label>$INFO[ListItem.Label]</label>
        <visible>Control.HasFocus(9000) | Control.HasFocus(9002)</visible>
      </control>
      <control type="label">
        <left>300</left><top>0</top><width>70</width><height>64</height>
        <font>font12</font><textcolor>{{TEXT_FAINT}}</textcolor><align>right</align><aligny>center</aligny>
        <label>$INFO[ListItem.Label2]</label>
        <visible>Control.HasFocus(9000) | Control.HasFocus(9002)</visible>
      </control>
    </itemlayout>
    <focusedlayout width="392" height="64">
      <control type="image">
        <left>14</left><top>2</top><width>364</width><height>60</height>
        <texture border="16" colordiffuse="{{ELEV2}}">reelhouse/ui/box.png</texture>
        <visible>Control.HasFocus({{list}})</visible>
      </control>
      <control type="image">
        <left>36</left><top>12</top><width>40</width><height>40</height>
        <texture colordiffuse="{{TEXT_DIM}}">$INFO[ListItem.Property(icon)]</texture>
        <visible>!String.IsEqual(ListItem.Property(active),true) + !Control.HasFocus({{list}})</visible>
      </control>
      <control type="image">
        <left>36</left><top>12</top><width>40</width><height>40</height>
        <texture colordiffuse="{{TEXT}}">$INFO[ListItem.Property(icon)]</texture>
        <visible>!String.IsEqual(ListItem.Property(active),true) + Control.HasFocus({{list}})</visible>
      </control>
      <control type="image">
        <left>36</left><top>12</top><width>40</width><height>40</height>
        <texture colordiffuse="{{ACCENT}}">$INFO[ListItem.Property(icon)]</texture>
        <visible>String.IsEqual(ListItem.Property(active),true)</visible>
      </control>
      <control type="image">
        <left>36</left><top>12</top><width>40</width><height>40</height>
        <texture colordiffuse="{{DANGER}}">$INFO[ListItem.Property(spot)]</texture>
      </control>
      <control type="label">
        <left>104</left><top>0</top><width>210</width><height>64</height>
        <font>font13</font><textcolor>{{TEXT}}</textcolor><aligny>center</aligny>
        <label>$INFO[ListItem.Label]</label>
        <visible>Control.HasFocus(9000) | Control.HasFocus(9002)</visible>
      </control>
      <control type="label">
        <left>300</left><top>0</top><width>70</width><height>64</height>
        <font>font12</font><textcolor>{{TEXT_DIM}}</textcolor><align>right</align><aligny>center</aligny>
        <label>$INFO[ListItem.Label2]</label>
        <visible>Control.HasFocus(9000) | Control.HasFocus(9002)</visible>
      </control>
    </focusedlayout>
  </control>
