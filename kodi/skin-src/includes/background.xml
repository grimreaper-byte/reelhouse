<!-- Kodi's player waits for something to draw a video's pictures: with nothing to, a video carrying on behind a screen stalls,
     stutters and jumps. As small as can be and first, so the background covers it, nothing shows and little is redrawn. -->
<control type="videowindow">
  <left>0</left><top>0</top><width>16</width><height>9</height>
  <visible>Player.HasVideo</visible>
</control>
<control type="image">
  <left>0</left><top>0</top><width>1920</width><height>1080</height>
  <texture colordiffuse="{{BG}}">reelhouse/ui/white.png</texture>
</control>
