<!-- A poster card in a library's grid (190×285). -->
<control type="image">
  <left>12</left><top>12</top><width>190</width><height>285</height>
  <texture border="16" colordiffuse="{{ELEV2}}">reelhouse/ui/box.png</texture>
</control>
<control type="label">
  <left>22</left><top>22</top><width>170</width><height>265</height>
  <font>font12</font><textcolor>{{TEXT_FAINT}}</textcolor><align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
  <label>$INFO[ListItem.Label]</label>
  <visible>String.IsEmpty(ListItem.Art(poster))</visible>
</control>
<control type="image">
  <left>12</left><top>12</top><width>190</width><height>285</height>
  <aspectratio>scale</aspectratio><fadetime>200</fadetime>
  <texture background="true" diffuse="reelhouse/ui/mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
</control>
<control type="progress">
  <left>22</left><top>281</top><width>170</width><height>6</height>
  <info>ListItem.PercentPlayed</info>
  <texturebg colordiffuse="B0000000">reelhouse/ui/white.png</texturebg>
  <midtexture colordiffuse="{{ACCENT}}">reelhouse/ui/white.png</midtexture>
  <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
</control>
<control type="group">
  <left>164</left><top>20</top>
  <visible>String.IsEqual(ListItem.Property(watched),true)</visible>
  <control type="image"><width>30</width><height>30</height><texture colordiffuse="{{ACCENT}}">reelhouse/ui/circle.png</texture></control>
  <control type="image"><left>5</left><top>5</top><width>20</width><height>20</height><texture colordiffuse="{{ACCENT_TEXT}}">reelhouse/icons/check.png</texture></control>
</control>
<control type="group">
  <left>146</left><top>20</top>
  <visible>!String.IsEmpty(ListItem.Property(badge))</visible>
  <control type="image"><width>48</width><height>32</height><texture border="15" colordiffuse="{{ACCENT}}">reelhouse/ui/pill-small.png</texture></control>
  <control type="label">
    <width>48</width><height>32</height>
    <font>font20_title</font><textcolor>{{ACCENT_TEXT}}</textcolor><align>center</align><aligny>center</aligny>
    <label>$INFO[ListItem.Property(badge)]</label>
  </control>
</control>
<control type="label">
  <left>12</left><top>306</top><width>190</width><height>36</height>
  <font>font12</font><textcolor>{{TEXT}}</textcolor>
  <label>$INFO[ListItem.Label]</label>
</control>
<control type="label">
  <left>12</left><top>342</top><width>190</width><height>32</height>
  <font>font10</font><textcolor>{{TEXT_DIM}}</textcolor>
  <label>$INFO[ListItem.Label2]</label>
</control>
