<!-- Made by kodi/tools/build_skin.py from kodi/skin-src/windows/reelhouse-live-osd.xml: edit that, not this. -->
<!-- Reelhouse's own player controls while a live channel plays (live_osd.py), laid out as Kodi's are for a channel from
     its own TV add-ons (Estuary's DialogSeekBar, VideoOSD and top bar): the programme's start and end above the ends of
     its progress bar, how far into it and how long it is in the middle, the clock with when it ends, and the channel's
     logo at the top left. A dialog over the picture that takes the remote: control 100 holds the focus (drawing
     nothing) while the controls are hidden. What it says is set on its controls from Python (changes to a dialog's own
     properties aren't drawn once it's open); what shows goes by home window properties, so the bars slide as Kodi's. -->
<window type="dialog">
  <defaultcontrol always="true">100</defaultcontrol>
  <controls>
    <control type="button" id="100">
      <left>0</left><top>0</top><width>1</width><height>1</height>
      <texturefocus>reelhouse/ui/clear.png</texturefocus><texturenofocus>reelhouse/ui/clear.png</texturenofocus>
      <onup>noop</onup><ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright><oninfo>noop</oninfo>
    </control>

    <!-- The top bar: the logo, the programme and the channel, the clock and when the programme ends. -->
    <control type="group" id="210">
